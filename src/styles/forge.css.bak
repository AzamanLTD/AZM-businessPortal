/* ============================================================================
   FORGE — the only place in this repository where a colour may be defined.
   ============================================================================ */

:root {
  /* ---------- neutral ink scale (the whole product) --------------------- */
  --f-ink-000:#ffffff; --f-ink-025:#fbfbfa; --f-ink-050:#f6f6f5;
  --f-ink-100:#eeeeec; --f-ink-150:#e4e4e1; --f-ink-200:#d8d8d4;
  --f-ink-300:#bcbcb6; --f-ink-400:#93938c; --f-ink-500:#6f6f68;
  --f-ink-600:#514f4a; --f-ink-700:#383632; --f-ink-800:#262521;
  --f-ink-900:#17161a; --f-ink-950:#0d0c0b;

  /* ---------- semantic surfaces ----------------------------------------- */
  --f-bg:            var(--f-ink-050);
  --f-surface:       var(--f-ink-000);
  --f-surface-sunken:var(--f-ink-100);
  --f-surface-raised:var(--f-ink-000);
  --f-rail:          #17161a;   /* the icon rail is black in both themes */

  /* ---------- text ------------------------------------------------------- */
  --f-text:   #17161a;
  --f-text-2: #55534f;
  --f-text-3: #8b8983;
  --f-text-inv:#fbfbfa;

  /* ---------- lines ------------------------------------------------------ */
  --f-line:         #e2e1dd;
  --f-line-strong:  #cfcec8;
  --f-line-contrast:#17161a;

  /* ---------- the single accent ------------------------------------------ */
  --f-accent:      #17161a;
  --f-accent-text: #ffffff;

  /* ---------- semantic status (data only, never chrome) ------------------ */
  --f-ok:#1f7a4d;   --f-ok-bg:#e8f3ec;
  --f-warn:#8a5a06; --f-warn-bg:#fbf1de;
  --f-bad:#a52826;  --f-bad-bg:#fbeceb;
  --f-info:#1f4f8f; --f-info-bg:#e8eff8;

  /* ---------- vertical tint (hue only, 3 uses — see Part 2.3) ------------ */
  --f-tint: 0; --f-tint-sat: 0%;
  --f-tint-color: hsl(var(--f-tint) var(--f-tint-sat) 42%);

  /* ---------- depth: hard edge + short ambient. NEVER blur. -------------- */
  --f-d-flush: inset 0 0 0 1px var(--f-line);
  --f-d-1: 0 1px 0 0 var(--f-line-strong), 0 1px 2px -1px rgb(23 22 26 / .10);
  --f-d-2: 0 1px 0 0 var(--f-line-strong), 0 2px 4px -2px rgb(23 22 26 / .12),
           0 8px 16px -8px rgb(23 22 26 / .10);
  --f-d-3: 0 2px 0 0 var(--f-line-strong), 0 8px 12px -6px rgb(23 22 26 / .14),
           0 24px 40px -20px rgb(23 22 26 / .18);
  --f-bevel: inset 0 1px 0 0 rgb(255 255 255 / .70);

  /* ---------- geometry ---------------------------------------------------- */
  --f-r-1:4px; --f-r-2:6px; --f-r-3:8px; --f-r-4:12px; --f-r-pill:999px;
  --f-u:4px;
  --f-row:32px; --f-row-sm:26px; --f-row-lg:38px;
  --f-rail-w:52px; --f-panel-w:212px; --f-topbar-h:48px;

  /* ---------- type -------------------------------------------------------- */
  --f-font: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
  --f-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --f-t-xs:11px; --f-t-sm:12px; --f-t-md:13px;
  --f-t-lg:15px; --f-t-xl:19px; --f-t-2xl:24px; --f-t-3xl:30px;

  /* ---------- motion ------------------------------------------------------ */
  --f-e-out: cubic-bezier(.16,1,.3,1);
  --f-e-io:  cubic-bezier(.4,0,.2,1);
  --f-t-press:60ms; --f-t-release:110ms; --f-t-hover:120ms;
  --f-t-panel:180ms; --f-t-page:200ms;
}

.dark {
  --f-bg:#0b0b0d;
  --f-surface:#141416;
  --f-surface-sunken:#0f0f11;
  --f-surface-raised:#1a1a1d;
  --f-rail:#000000;

  --f-text:#f2f2ef; --f-text-2:#a5a49f; --f-text-3:#6e6d68; --f-text-inv:#0b0b0d;
  --f-line:#26262a; --f-line-strong:#34343a; --f-line-contrast:#f2f2ef;

  --f-accent:#f2f2ef; --f-accent-text:#0b0b0d;

  --f-ok:#4ade9b;   --f-ok-bg:#0f2419;
  --f-warn:#e8b45c; --f-warn-bg:#2a2010;
  --f-bad:#f08a86;  --f-bad-bg:#2c1413;
  --f-info:#7fb0f5; --f-info-bg:#111f33;

  --f-tint-color: hsl(var(--f-tint) var(--f-tint-sat) 62%);

  --f-bevel: inset 0 1px 0 0 rgb(255 255 255 / .10);
  --f-d-1: 0 1px 0 0 #000, 0 1px 2px -1px rgb(0 0 0 / .80);
  --f-d-2: 0 1px 0 0 #000, 0 2px 4px -2px rgb(0 0 0 / .80),
           0 8px 16px -8px rgb(0 0 0 / .70);
  --f-d-3: 0 2px 0 0 #000, 0 8px 12px -6px rgb(0 0 0 / .80),
           0 24px 40px -20px rgb(0 0 0 / .90);
}

/* vertical tints — hue only */
[data-vertical="hotel"]      { --f-tint:214; --f-tint-sat:64%; }
[data-vertical="restaurant"] { --f-tint:24;  --f-tint-sat:72%; }
[data-vertical="transit"]    { --f-tint:152; --f-tint-sat:58%; }
[data-vertical="retail"]     { --f-tint:280; --f-tint-sat:48%; }
[data-vertical="services"]   { --f-tint:190; --f-tint-sat:52%; }
[data-vertical="general"]    { --f-tint:0;   --f-tint-sat:0%;  }

/* ---------- base ---------------------------------------------------------- */
html { color-scheme: light dark; }
body {
  margin:0;
  font-family: var(--f-font);
  font-size: var(--f-t-md);
  line-height: 1.45;
  color: var(--f-text);
  background: var(--f-bg);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-feature-settings: "cv11","ss03";
}

/* ---------- utilities ----------------------------------------------------- */
.f-eyebrow{font:700 10px/1 var(--f-font);letter-spacing:.09em;text-transform:uppercase;color:var(--f-text-3)}
.f-num{font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-weight:500}

/* ---------- scrollbars --------------------------------------------------- */
* { scrollbar-width: thin; scrollbar-color: var(--f-line-strong) transparent; }
*::-webkit-scrollbar { width:10px; height:10px; }
*::-webkit-scrollbar-thumb {
  background: var(--f-line-strong); border-radius:99px;
  border:3px solid transparent; background-clip: content-box;
}
*::-webkit-scrollbar-thumb:hover { background: var(--f-ink-400); background-clip: content-box; }

@media (prefers-reduced-motion: reduce) {
  *,*::before,*::after {
    animation-duration:.01ms !important; animation-iteration-count:1 !important;
    transition-duration:.01ms !important; scroll-behavior:auto !important;
  }
}

/* ============================================================================
   COMPONENT LAYER — added in Phase 2
   ============================================================================ */

/* ---------- Button (5.1) -------------------------------------------------- */
.f-btn{
  --btn-bg: var(--f-surface);
  --btn-fg: var(--f-text);
  --btn-line: var(--f-line-strong);
  --lip: 2px;

  position:relative; display:inline-flex; align-items:center; justify-content:center;
  gap:6px; height:var(--f-row); padding:0 12px; border-radius:var(--f-r-2);
  font:600 var(--f-t-md)/1 var(--f-font); letter-spacing:-.005em; white-space:nowrap;
  color:var(--btn-fg); background:var(--btn-bg);
  border:1px solid var(--btn-line);
  box-shadow: 0 var(--lip) 0 0 var(--btn-line), var(--f-bevel),
              0 2px 4px -2px rgb(23 22 26 / .14);
  cursor:pointer; user-select:none; transform:translateY(0);
  transition: transform var(--f-t-release) var(--f-e-out),
              box-shadow var(--f-t-release) var(--f-e-out),
              background-color var(--f-t-hover) var(--f-e-io),
              border-color var(--f-t-hover) var(--f-e-io);
}
.f-btn:hover{
  background: color-mix(in oklab, var(--btn-bg) 94%, var(--f-line-contrast));
  box-shadow: 0 var(--lip) 0 0 var(--btn-line), var(--f-bevel),
              0 4px 8px -3px rgb(23 22 26 / .20);
}
.f-btn:active{
  transform: translateY(var(--lip));
  box-shadow: 0 0 0 0 var(--btn-line), inset 0 2px 3px -1px rgb(23 22 26 / .28);
  transition: transform var(--f-t-press) var(--f-e-out),
              box-shadow  var(--f-t-press) var(--f-e-out);
}
.f-btn:disabled{ opacity:.45; pointer-events:none; }

.f-btn--primary{ --btn-bg:var(--f-accent); --btn-fg:var(--f-accent-text); --btn-line:#000; }
.dark .f-btn--primary{ --btn-line:#5a5a60; }
.f-btn--primary:hover{ background: color-mix(in oklab, var(--f-accent) 88%, #fff); }

.f-btn--ghost{ --btn-bg:transparent; --btn-line:transparent; --lip:0; box-shadow:none; }
.f-btn--ghost:hover{ background:var(--f-surface-sunken); box-shadow:none; }
.f-btn--ghost:active{ transform:none; box-shadow: inset 0 1px 2px rgb(23 22 26 / .18); }

.f-btn--danger{ --btn-bg:var(--f-bad); --btn-fg:#fff;
                --btn-line: color-mix(in oklab, var(--f-bad) 70%, #000); }
.dark .f-btn--danger{ --btn-bg:#3a1615; --btn-fg:#f6a09c; --btn-line:#5c2321; }
.dark .f-btn--danger:hover{ background:#4a1b1a; }

.f-btn--sm  { height:var(--f-row-sm); padding:0 9px;  font-size:var(--f-t-sm); }
.f-btn--lg  { height:var(--f-row-lg); padding:0 16px; font-size:var(--f-t-lg); }
.f-btn--icon{ width:var(--f-row); padding:0; }
.f-btn--icon.f-btn--sm{ width:var(--f-row-sm); }
.f-btn--block{ width:100%; }

/* ---------- Kbd (5.2) ----------------------------------------------------- */
.f-kbd{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:18px; height:18px; padding:0 5px; border-radius:var(--f-r-1);
  font:600 10.5px/1 var(--f-mono); color:var(--f-text-3);
  background:var(--f-surface); border:1px solid var(--f-line-strong);
  box-shadow: 0 1.5px 0 0 var(--f-line-strong), var(--f-bevel);
}

/* ---------- Tag (5.3) ----------------------------------------------------- */
.f-tag{
  display:inline-flex; align-items:center; gap:5px; height:20px; padding:0 7px;
  border-radius:var(--f-r-1); font:650 11px/1 var(--f-font);
  border:1px solid transparent; white-space:nowrap;
}
.f-tag>i{ width:5px; height:5px; border-radius:50%; background:currentColor; flex:none; }
.f-tag--neutral{ color:var(--f-text-2); background:var(--f-surface-sunken); border-color:var(--f-line); }
.f-tag--ok  { color:var(--f-ok);   background:var(--f-ok-bg);   border-color:color-mix(in oklab,var(--f-ok) 25%,transparent); }
.f-tag--warn{ color:var(--f-warn); background:var(--f-warn-bg); border-color:color-mix(in oklab,var(--f-warn) 25%,transparent); }
.f-tag--bad { color:var(--f-bad);  background:var(--f-bad-bg);  border-color:color-mix(in oklab,var(--f-bad) 25%,transparent); }
.f-tag--info{ color:var(--f-info); background:var(--f-info-bg); border-color:color-mix(in oklab,var(--f-info) 25%,transparent); }

/* ---------- Field (5.4) --------------------------------------------------- */
.f-field{ display:flex; flex-direction:column; gap:5px; min-width:0; }
.f-field>label{ font:650 var(--f-t-xs)/1 var(--f-font); color:var(--f-text-2); }
.f-field__hint{ font-size:var(--f-t-xs); color:var(--f-text-3); }
.f-field__err { font-size:var(--f-t-xs); color:var(--f-bad); }

.f-input{
  height:var(--f-row); padding:0 10px; width:100%;
  border-radius:var(--f-r-2); border:1px solid var(--f-line-strong);
  background:var(--f-surface); color:var(--f-text);
  font:500 var(--f-t-md)/1 var(--f-font);
  box-shadow: inset 0 1px 2px rgb(23 22 26 / .06);
  transition: border-color var(--f-t-hover) var(--f-e-io),
              box-shadow  var(--f-t-hover) var(--f-e-io);
}
.f-input::placeholder{ color:var(--f-text-3); }
.f-input:hover{ border-color:var(--f-ink-400); }
.f-input:focus{
  outline:0; border-color:var(--f-line-contrast);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--f-line-contrast) 14%, transparent);
}
.f-input[aria-invalid="true"]{
  border-color:var(--f-bad);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--f-bad) 16%, transparent);
}
textarea.f-input{ height:auto; padding:8px 10px; line-height:1.5; resize:vertical; }

/* ---------- Card (5.5) ----------------------------------------------------- */
.f-card{
  background:var(--f-surface); border:1px solid var(--f-line);
  border-radius:var(--f-r-3); box-shadow:var(--f-d-1);
}
.f-card--raised{ box-shadow:var(--f-d-2); }
.f-card--flush { box-shadow:none; }
.f-card__head{
  display:flex; align-items:center; gap:8px; min-height:40px;
  padding:0 14px; border-bottom:1px solid var(--f-line);
}
.f-card__title{ font:650 var(--f-t-md)/1 var(--f-font); }
.f-card__body{ padding:14px; }

/* ---------- Segmented (5.6) ----------------------------------------------- */
.f-seg{ display:inline-flex; gap:2px; padding:2px; background:var(--f-surface-sunken);
        border:1px solid var(--f-line); border-radius:var(--f-r-2); }
.f-seg button{
  position:relative; height:24px; padding:0 10px; border:0; background:transparent;
  border-radius:var(--f-r-1); font:600 var(--f-t-sm)/1 var(--f-font);
  color:var(--f-text-3); cursor:pointer;
  transition: color var(--f-t-hover) var(--f-e-io);
}
.f-seg button:hover{ color:var(--f-text-2); }
.f-seg button[aria-selected="true"]{ color:var(--f-text); }
.f-seg__pill{ position:absolute; inset:0; z-index:-1; border-radius:var(--f-r-1);
  background:var(--f-surface); box-shadow:0 1px 0 0 var(--f-line-strong), var(--f-bevel); }

/* ---------- Shell (6.1) --------------------------------------------------- */
.f-shell{ display:grid; grid-template-columns: var(--f-rail-w) var(--f-panel-w) minmax(0,1fr);
          height:100dvh; overflow:hidden; }
.f-shell[data-panel="collapsed"]{ grid-template-columns: var(--f-rail-w) 0 minmax(0,1fr); }
@media (max-width:1023px){ .f-shell{ grid-template-columns: minmax(0,1fr); } }

/* rail */
.f-rail{ background:var(--f-rail); display:flex; flex-direction:column; align-items:center;
         gap:2px; padding:8px 0 8px 8px; border-right:1px solid #000; }
.f-rail__mark{ width:28px; height:28px; border-radius:var(--f-r-2); background:#fff; color:#000;
  display:grid; place-items:center; font:800 13px/1 var(--f-font); margin-bottom:10px; }
.f-rail__btn{
  position:relative; width:36px; height:36px; border-radius:var(--f-r-2);
  display:grid; place-items:center; color:#8b8a92; background:transparent; border:0; cursor:pointer;
  transition: color var(--f-t-hover) var(--f-e-io), background-color var(--f-t-hover) var(--f-e-io);
}
.f-rail__btn:hover{ color:#fff; background:rgb(255 255 255 / .07); }
.f-rail__btn[aria-current="true"]{
  color:#0b0b0d; background:#fff;
  box-shadow: 0 1px 0 0 rgb(0 0 0 / .6), inset 0 1px 0 0 rgb(255 255 255 / .9);
}
.f-rail__btn[aria-current="true"]::after{
  content:''; position:absolute; left:6px; right:6px; bottom:-4px; height:2px;
  border-radius:2px; background:var(--f-tint-color);
}

/* panel */
.f-panel{ background:var(--f-surface); border-right:1px solid var(--f-line);
          display:flex; flex-direction:column; min-width:0; overflow:hidden; }
.f-panel__head{ height:var(--f-topbar-h); display:flex; align-items:center; gap:8px;
  padding:0 12px; border-bottom:1px solid var(--f-line);
  font:700 var(--f-t-md)/1 var(--f-font); letter-spacing:-.01em; }
.f-panel__body{ flex:1; overflow-y:auto; padding:8px; }
.f-navgrp{ margin-bottom:10px; }
.f-navgrp__label{ font:700 10px/1 var(--f-font); letter-spacing:.09em;
                  text-transform:uppercase; color:var(--f-text-3); padding:6px 8px; }
.f-nav{
  position:relative; display:flex; align-items:center; gap:8px; height:28px; padding:0 8px;
  border-radius:var(--f-r-2); color:var(--f-text-2); font:500 var(--f-t-md)/1 var(--f-font);
  text-decoration:none; cursor:pointer;
  transition: color var(--f-t-hover) var(--f-e-io), background-color var(--f-t-hover) var(--f-e-io);
}
.f-nav:hover{ color:var(--f-text); background:var(--f-surface-sunken); }
.f-nav[aria-current="page"]{ color:var(--f-text); font-weight:650;
  background:var(--f-surface-sunken); box-shadow:var(--f-d-flush); }
.f-nav__badge{ margin-left:auto; font:600 10.5px/1 var(--f-mono); color:var(--f-text-3); }
.f-nav[aria-current="page"] .f-nav__badge{ color:var(--f-text-2); }
.f-nav__badge--alert{ color:var(--f-bad); }

/* topbar */
.f-topbar{
  position:sticky; top:0; z-index:20; height:var(--f-topbar-h);
  display:flex; align-items:center; gap:8px; padding:0 16px;
  background: color-mix(in oklab, var(--f-bg) 86%, transparent);
  backdrop-filter: saturate(180%) blur(8px);
  border-bottom:1px solid var(--f-line);
}
.f-main{ overflow-y:auto; background:var(--f-bg); }
.f-content{ padding:20px; max-width:1440px; }

/* ---------- Tooltip (6.3) ------------------------------------------------- */
.f-tip{
  padding:5px 8px; border-radius:var(--f-r-2);
  background:var(--f-ink-900); color:var(--f-ink-025);
  font:600 var(--f-t-xs)/1.3 var(--f-font); box-shadow:var(--f-d-2);
  max-width:240px; z-index:60;
}
.dark .f-tip{ background:var(--f-ink-100); color:var(--f-ink-900); }

/* ---------- Command palette (6.4) ----------------------------------------- */
.f-scrim{ position:fixed; inset:0; z-index:70;
          background:rgb(12 12 14 / .44); backdrop-filter:blur(1px); }
.f-pal{
  position:fixed; z-index:71; left:50%; top:14vh; transform:translateX(-50%);
  width:min(640px,92vw); background:var(--f-surface);
  border:1px solid var(--f-line-strong); border-radius:var(--f-r-4);
  box-shadow:var(--f-d-3); overflow:hidden;
}
.f-pal__in{ display:flex; align-items:center; gap:10px; height:48px; padding:0 14px;
            border-bottom:1px solid var(--f-line); }
.f-pal__in input{ flex:1; border:0; outline:0; background:transparent;
                  font:500 var(--f-t-lg)/1 var(--f-font); color:var(--f-text); }
.f-pal__list{ max-height:52vh; overflow-y:auto; padding:6px 0; }
.f-pal__grp{ font:700 10px/1 var(--f-font); letter-spacing:.09em; text-transform:uppercase;
             color:var(--f-text-3); padding:10px 14px 6px; }
.f-pal__it{ display:flex; align-items:center; gap:10px; height:36px; padding:0 14px;
            font-size:var(--f-t-md); color:var(--f-text-2); cursor:pointer; }
.f-pal__it[data-selected="true"]{
  background:var(--f-surface-sunken); color:var(--f-text);
  box-shadow: inset 2px 0 0 0 var(--f-line-contrast);
}
.f-pal__ft{ display:flex; align-items:center; gap:12px; height:34px; padding:0 14px;
            border-top:1px solid var(--f-line); background:var(--f-surface-sunken);
            font-size:var(--f-t-xs); color:var(--f-text-3); }

/* ---------- DataTable (7.1) ----------------------------------------------- */
.f-tab{ width:100%; border-collapse:separate; border-spacing:0; font-size:var(--f-t-md); }
.f-tab th{
  position:sticky; top:0; z-index:2; background:var(--f-surface-sunken); text-align:left;
  font:700 10px/1 var(--f-font); letter-spacing:.08em; text-transform:uppercase;
  color:var(--f-text-3); padding:0 12px; height:30px;
  border-bottom:1px solid var(--f-line); white-space:nowrap; user-select:none;
}
.f-tab th[aria-sort]{ cursor:pointer; }
.f-tab th[aria-sort]:hover{ color:var(--f-text-2); }
.f-tab td{ padding:0 12px; height:36px; border-bottom:1px solid var(--f-line);
           color:var(--f-text-2); }
.f-tab[data-density="compact"] td{ height:30px; }
.f-tab[data-density="relaxed"] td{ height:44px; }
.f-tab tbody tr{ transition: background-color 90ms var(--f-e-io); }
.f-tab tbody tr:hover{ background:var(--f-surface-sunken); }
.f-tab tbody tr[data-selected="true"]{ background:var(--f-surface-sunken); }
.f-tab tbody tr[data-focused="true"]{ box-shadow: inset 2px 0 0 0 var(--f-line-contrast); }
.f-tab td b, .f-tab td strong{ color:var(--f-text); font-weight:600; }
.f-tab .f-num{ text-align:right; }
.f-rowacts{ display:flex; gap:4px; opacity:0; transition:opacity 90ms var(--f-e-io); }
tr:hover .f-rowacts, tr:focus-within .f-rowacts{ opacity:1; }

/* ---------- KpiCard (7.2) ------------------------------------------------- */
.f-kpi{ position:relative; overflow:hidden; padding:14px 16px; }
.f-kpi__k{ font:700 10px/1 var(--f-font); letter-spacing:.09em;
           text-transform:uppercase; color:var(--f-text-3); }
.f-kpi__v{ margin-top:8px; font:700 var(--f-t-2xl)/1.1 var(--f-font);
           letter-spacing:-.03em; font-variant-numeric:tabular-nums; color:var(--f-text); }
.f-kpi__d{ display:inline-flex; align-items:center; gap:4px; margin-top:8px;
           font:600 var(--f-t-xs)/1 var(--f-mono); }
.f-kpi__d--up{ color:var(--f-ok); } .f-kpi__d--down{ color:var(--f-bad); }
.f-kpi__d--flat{ color:var(--f-text-3); }
.f-kpi[data-polarity="invert"] .f-kpi__d--up  { color:var(--f-bad); }
.f-kpi[data-polarity="invert"] .f-kpi__d--down{ color:var(--f-ok); }
.f-kpi::after{ content:''; position:absolute; inset:auto 0 0 0; height:2px;
  background:var(--f-line-contrast); transform:scaleX(0); transform-origin:left;
  transition: transform 260ms var(--f-e-out); }
.f-kpi:hover::after{ transform:scaleX(1); }

/* ---------- EmptyState (7.5) ---------------------------------------------- */
.f-empty{ display:grid; place-items:center; gap:10px; padding:44px 20px; text-align:center; }
.f-empty__art{ width:104px; height:56px; position:relative; margin-bottom:2px; }
.f-empty__art i{ position:absolute; left:0; height:8px; border-radius:2px;
                 background:var(--f-surface-sunken); box-shadow:var(--f-d-flush); }
.f-empty__art i:nth-child(1){ top:0;  right:26px; }
.f-empty__art i:nth-child(2){ top:16px; right:8px; }
.f-empty__art i:nth-child(3){ top:32px; right:44px; }
.f-empty__art i:nth-child(4){ top:48px; right:18px; opacity:.5; }
.f-empty h4{ margin:0; font:650 var(--f-t-md)/1.3 var(--f-font); color:var(--f-text); }
.f-empty p { margin:0; font-size:var(--f-t-sm); color:var(--f-text-3); max-width:42ch; }

/* ---------- Skeletons (7.6) ----------------------------------------------- */
.f-sk{
  border-radius:var(--f-r-1);
  background: linear-gradient(90deg,
    var(--f-surface-sunken) 25%,
    color-mix(in oklab, var(--f-surface-sunken) 60%, var(--f-surface)) 37%,
    var(--f-surface-sunken) 63%);
  background-size:400% 100%;
  animation: f-sk 1.4s var(--f-e-io) infinite;
}
@keyframes f-sk { from { background-position:100% 0 } to { background-position:0 0 } }
@media (prefers-reduced-motion:reduce){ .f-sk{ animation:none } }

/* ---------- Toast (7.7) --------------------------------------------------- */
.f-toast{ display:flex; align-items:center; gap:10px; min-width:300px; max-width:420px;
  padding:10px 12px; border-radius:var(--f-r-3); background:var(--f-surface);
  border:1px solid var(--f-line-strong); box-shadow:var(--f-d-3); font-size:var(--f-t-md); }
.f-toast__bar{ width:3px; align-self:stretch; border-radius:2px; background:var(--f-text-3); }
.f-toast[data-kind="success"] .f-toast__bar{ background:var(--f-ok); }
.f-toast[data-kind="error"]   .f-toast__bar{ background:var(--f-bad); }
.f-toast[data-kind="warning"] .f-toast__bar{ background:var(--f-warn); }
.f-toast__t{ font-weight:650; color:var(--f-text); }
.f-toast__d{ font-size:var(--f-t-sm); color:var(--f-text-3); }

/* ---------- Kitchen ticket overdue pulse (10.2) -------------------------- */
.f-ticket--overdue{ animation: f-pulse 2s var(--f-e-io) infinite; }
@keyframes f-pulse{ 0%,100%{opacity:1} 50%{opacity:.72} }
@media (prefers-reduced-motion:reduce){
  .f-ticket--overdue{ animation:none; outline:2px solid var(--f-bad); outline-offset:-2px; }
}

/* ---------- divider ------------------------------------------------------- */
.f-divider{ width:1px; height:24px; background:var(--f-line); }

/* ============================================================================
   EXTENDED COMPONENT LAYER — Shell, Modal, Command Palette, Pop, etc.
   ============================================================================ */

/* ---------- Shell (3-column → 2-column responsive) ------------------------ */
.f-shell{
  display:grid; grid-template-columns: var(--f-panel-w) minmax(0,1fr);
  min-height:100vh; background:var(--f-bg);
}
.f-shell[data-collapsed]{ grid-template-columns: var(--f-rail-w) minmax(0,1fr); }

/* Sidebar */
.f-rail{
  background:var(--f-rail); color:var(--f-text-inv);
  display:flex; flex-direction:column; overflow-y:auto; overflow-x:hidden;
  border-right:1px solid var(--f-line); z-index:30;
}
.f-shell[data-collapsed] .f-rail{ width:var(--f-rail-w); }
.f-rail__brand{
  display:flex; align-items:center; gap:8px;
  height:var(--f-topbar-h); padding:0 14px; flex-shrink:0;
}
.f-rail__logo{
  width:26px; height:26px; border-radius:var(--f-r-2); flex-shrink:0;
  background:var(--f-tint-color); color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-weight:800; font-size:13px; letter-spacing:-.04em;
}
.f-rail__name{ font-weight:700; font-size:var(--f-t-md); color:var(--f-text-inv); white-space:nowrap; }

.f-rail__nav{ flex:1; padding:4px 8px 24px; display:flex; flex-direction:column; gap:2px; }
.f-rail__domain{ display:flex; flex-direction:column; }
.f-rail__domain-label{
  font:700 10px/1 var(--f-font); letter-spacing:.09em; text-transform:uppercase;
  color: rgb(255 255 255 / .35); padding:14px 10px 6px; white-space:nowrap;
}
.f-rail__group{ display:flex; flex-direction:column; }
.f-rail__item{
  display:flex; align-items:center; gap:9px; height:32px; padding:0 10px;
  border-radius:var(--f-r-2); font-size:var(--f-t-md); font-weight:500;
  color: rgb(255 255 255 / .60); text-decoration:none; white-space:nowrap;
  transition: color var(--f-t-hover) var(--f-e-io),
              background var(--f-t-hover) var(--f-e-io);
}
.f-rail__item:hover{ color:var(--f-text-inv); background: rgb(255 255 255 / .06); }
.f-rail__item.is-active{
  color:var(--f-text-inv); background: rgb(255 255 255 / .10);
  font-weight:600;
}
.f-rail__item.is-active::before{
  content:''; position:absolute; left:0; width:3px; height:20px;
  background:var(--f-tint-color); border-radius:0 2px 2px 0; margin-left:-8px;
}
.f-rail__item-label{ flex:1; overflow:hidden; text-overflow:ellipsis; }
.f-rail__badge{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:18px; height:18px; padding:0 5px; border-radius:var(--f-r-pill);
  font:600 10px/1 var(--f-font); background:var(--f-tint-color); color:#fff;
}

/* Mobile drawer */
.f-rail--mobile{ position:fixed; inset:0 auto 0 0; width:240px; z-index:50; }

/* Main column */
.f-main{ display:flex; flex-direction:column; min-width:0; min-height:100vh; }
.f-content{ flex:1; padding:24px; max-width:1400px; width:100%; margin:0 auto; }
@media (max-width:768px){ .f-content{ padding:16px; } }

/* ---------- Topbar -------------------------------------------------------- */
.f-topbar{
  position:sticky; top:0; z-index:20; height:var(--f-topbar-h);
  display:flex; align-items:center; justify-content:space-between;
  padding:0 16px; background: color-mix(in oklab, var(--f-bg) 85%, transparent);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom:1px solid var(--f-line);
}
.f-topbar__left{ display:flex; align-items:center; gap:8px; min-width:0; }
.f-topbar__right{ display:flex; align-items:center; gap:6px; }
.f-topbar__crumb{
  display:flex; align-items:center; gap:6px; font-size:var(--f-t-md);
  font-weight:500; color:var(--f-text-3); white-space:nowrap; overflow:hidden;
}

/* ---------- Icon button --------------------------------------------------- */
.f-icon-btn{
  display:inline-flex; align-items:center; justify-content:center;
  width:32px; height:32px; border-radius:var(--f-r-2); border:none; cursor:pointer;
  color:var(--f-text-3); background:transparent;
  transition: background var(--f-t-hover) var(--f-e-io),
              color var(--f-t-hover) var(--f-e-io);
}
.f-icon-btn:hover{ background:var(--f-surface-sunken); color:var(--f-text); }
.f-icon-btn:active{ background:var(--f-line); }

/* ---------- Command palette trigger -------------------------------------- */
.f-cmd-trigger{
  display:flex; align-items:center; gap:8px; height:30px; padding:0 10px;
  border-radius:var(--f-r-2); border:1px solid var(--f-line); background:var(--f-surface);
  color:var(--f-text-3); font-size:var(--f-t-sm); cursor:pointer; min-width:200px;
  transition: border-color var(--f-t-hover) var(--f-e-io),
              box-shadow var(--f-t-hover) var(--f-e-io);
}
.f-cmd-trigger:hover{ border-color:var(--f-line-strong); box-shadow:var(--f-d-1); }
.f-cmd-trigger>span{ flex:1; text-align:left; }

/* ---------- Command palette ---------------------------------------------- */
.f-cmd-root{ position:fixed; inset:0; z-index:60; display:flex; align-items:flex-start;
  justify-content:center; padding-top:12vh; pointer-events:none; }
.f-cmd{
  pointer-events:auto; width:min(560px,90vw); max-height:60vh; overflow:hidden;
  display:flex; flex-direction:column; border-radius:var(--f-r-3);
  background:var(--f-surface); border:1px solid var(--f-line-strong);
  box-shadow:var(--f-d-3); }
.f-cmd__input{
  display:flex; align-items:center; gap:8px; padding:12px 14px;
  border-bottom:1px solid var(--f-line); }
.f-cmd__input input{
  flex:1; border:none; outline:none; background:transparent;
  font:500 var(--f-t-md)/1 var(--f-font); color:var(--f-text); }
.f-cmd__input input::placeholder{ color:var(--f-text-3); }
.f-cmd__list{ overflow-y:auto; padding:4px; }
.f-cmd__item{
  display:flex; align-items:center; gap:8px; width:100%; padding:8px 10px;
  border-radius:var(--f-r-2); border:none; background:transparent; cursor:pointer;
  font:500 var(--f-t-md)/1 var(--f-font); color:var(--f-text-2); text-align:left;
  transition: background var(--f-t-hover) var(--f-e-io);
}
.f-cmd__item.is-active{ background:var(--f-surface-sunken); color:var(--f-text); }
.f-cmd__item:hover{ background:var(--f-surface-sunken); }
.f-cmd__empty{ padding:20px; text-align:center; color:var(--f-text-3); font-size:var(--f-t-sm); }

/* ---------- Modal -------------------------------------------------------- */
.f-modal-root{ position:fixed; inset:0; z-index:50; display:flex; align-items:center;
  justify-content:center; padding:20px; pointer-events:none; }
.f-modal{
  pointer-events:auto; display:flex; flex-direction:column; max-height:85vh;
  width:min(560px,90vw); border-radius:var(--f-r-4); background:var(--f-surface);
  border:1px solid var(--f-line-strong); box-shadow:var(--f-d-3); overflow:hidden; }
.f-modal--sm{ width:min(400px,90vw); }
.f-modal--lg{ width:min(800px,90vw); }
.f-modal__head{
  display:flex; align-items:flex-start; justify-content:space-between;
  padding:16px 20px; border-bottom:1px solid var(--f-line); gap:12px; }
.f-modal__title{ font:700 var(--f-t-lg)/1.3 var(--f-font); color:var(--f-text); margin:0; }
.f-modal__desc{ font-size:var(--f-t-sm); color:var(--f-text-3); margin-top:4px; }
.f-modal__body{ flex:1; overflow-y:auto; padding:20px; }
.f-modal__foot{ display:flex; align-items:center; justify-content:flex-end; gap:8px;
  padding:12px 20px; border-top:1px solid var(--f-line); }

/* ---------- Popover (user menu, dropdowns) ------------------------------- */
.f-pop{
  position:absolute; z-index:40; min-width:180px; padding:4px;
  border-radius:var(--f-r-3); background:var(--f-surface);
  border:1px solid var(--f-line-strong); box-shadow:var(--f-d-2); }
.f-pop--right{ right:0; top:calc(100% + 6px); }
.f-pop--left{ left:0; top:calc(100% + 6px); }
.f-pop__group{ border-bottom:1px solid var(--f-line); padding:4px 0; }
.f-pop__group:last-child{ border-bottom:none; }
.f-pop__item{
  display:flex; align-items:center; gap:8px; width:100%; padding:7px 10px;
  border:none; border-radius:var(--f-r-2); background:transparent; cursor:pointer;
  font:500 var(--f-t-md)/1 var(--f-font); color:var(--f-text); text-align:left;
  transition: background var(--f-t-hover) var(--f-e-io);
}
.f-pop__item:hover{ background:var(--f-surface-sunken); }
.f-pop__item--danger{ color:var(--f-bad); }
.f-pop__item--danger:hover{ background:var(--f-bad-bg); }

/* ---------- Avatar ------------------------------------------------------- */
.f-avatar{
  display:inline-flex; align-items:center; justify-content:center;
  border-radius:var(--f-r-pill); font-weight:700; color:var(--f-text-inv);
  background:var(--f-tint-color); flex-shrink:0; }
.f-avatar--sm{ width:26px; height:26px; font-size:11px; }
.f-avatar--md{ width:32px; height:32px; font-size:13px; }
.f-avatar--lg{ width:40px; height:40px; font-size:15px; }
.f-avatar-btn{
  display:flex; align-items:center; gap:4px; padding:2px; border:none;
  background:transparent; cursor:pointer; border-radius:var(--f-r-pill); }

/* ---------- Status dot --------------------------------------------------- */
.f-dot{ position:absolute; top:6px; right:6px; width:7px; height:7px;
  border-radius:50%; border:1.5px solid var(--f-surface); }
.f-dot--warn{ background:var(--f-warn); }
.f-dot--ok{ background:var(--f-ok); }
.f-dot--bad{ background:var(--f-bad); }
.f-dot--info{ background:var(--f-info); }

/* ---------- Toast stack (updated for Forge toast) ------------------------ */
.f-toast-stack{
  position:fixed; bottom:20px; right:20px; z-index:70;
  display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.f-toast-stack> * { pointer-events:auto; }

/* Updated toast classes for Forge toast component */
.f-toast{ display:flex; align-items:flex-start; gap:10px; min-width:300px; max-width:420px;
  padding:12px 14px; border-radius:var(--f-r-3); background:var(--f-surface);
  border:1px solid var(--f-line-strong); box-shadow:var(--f-d-3); font-size:var(--f-t-md); }
.f-toast__icon{ flex-shrink:0; margin-top:1px; }
.f-toast--success .f-toast__icon{ color:var(--f-ok); }
.f-toast--error   .f-toast__icon{ color:var(--f-bad); }
.f-toast--info    .f-toast__icon{ color:var(--f-info); }
.f-toast__body{ flex:1; min-width:0; }
.f-toast__title{ font-weight:650; color:var(--f-text); }
.f-toast__desc{ font-size:var(--f-t-sm); color:var(--f-text-3); margin-top:2px; }
.f-toast__undo{
  margin-top:6px; border:none; background:transparent; cursor:pointer;
  font:600 var(--f-t-sm)/1 var(--f-font); color:var(--f-tint-color); padding:0; }
.f-toast__undo:hover{ text-decoration:underline; }
.f-toast__close{
  flex-shrink:0; display:flex; align-items:center; justify-content:center;
  width:24px; height:24px; border-radius:var(--f-r-1); border:none; cursor:pointer;
  background:transparent; color:var(--f-text-3);
  transition: background var(--f-t-hover) var(--f-e-io), color var(--f-t-hover) var(--f-e-io); }
.f-toast__close:hover{ background:var(--f-surface-sunken); color:var(--f-text); }

/* ---------- Card extensions --------------------------------------------- */
.f-card__head{ display:flex; align-items:center; justify-content:space-between;
  padding:14px 16px; border-bottom:1px solid var(--f-line); gap:12px; }
.f-card__title{ font:700 var(--f-t-md)/1.3 var(--f-font); color:var(--f-text); }
.f-card__body{ padding:16px; }

/* ---------- KPI card ----------------------------------------------------- */
.f-kpi{ padding:16px; display:flex; flex-direction:column; gap:0; }
.f-kpi__k{ font:700 10px/1 var(--f-font); letter-spacing:.09em; text-transform:uppercase;
  color:var(--f-text-3); }
.f-kpi__v{ font:700 var(--f-t-2xl)/1.2 var(--f-font); color:var(--f-text);
  margin-top:8px; font-variant-numeric:tabular-nums; letter-spacing:-.03em; }
.f-kpi__d{ display:flex; align-items:center; gap:3px; font:600 var(--f-t-sm)/1 var(--f-font);
  margin-top:6px; }
.f-kpi__d--up{ color:var(--f-ok); }
.f-kpi__d--down{ color:var(--f-bad); }
.f-kpi__d--flat{ color:var(--f-text-3); }
.f-kpi[data-polarity="invert"] .f-kpi__d--up{ color:var(--f-bad); }
.f-kpi[data-polarity="invert"] .f-kpi__d--down{ color:var(--f-ok); }

/* ---------- Table (Forge) ----------------------------------------------- */
.f-tab{ width:100%; border-collapse:collapse; font-size:var(--f-t-md); }
.f-tab[data-density="compact"] .f-tab td, .f-tab[data-density="compact"] .f-tab th{ height:32px; }
.f-tab thead th{
  height:30px; padding:0 12px; text-align:left; font-weight:600;
  font-size:var(--f-t-sm); color:var(--f-text-3); white-space:nowrap;
  border-bottom:1px solid var(--f-line); background:var(--f-surface-sunken);
  cursor:pointer; user-select:none;
}
.f-tab tbody td{ height:var(--f-row); padding:0 12px; border-bottom:1px solid var(--f-line);
  color:var(--f-text); }
.f-tab tbody tr{ transition: background var(--f-t-hover) var(--f-e-io); }
.f-tab tbody tr:hover{ background:var(--f-surface-sunken); }
.f-tab tbody tr[data-selected="true"]{ background:color-mix(in oklab,var(--f-tint-color) 6%,transparent); }
.f-tab tbody tr[data-focused="true"]{ outline:2px solid var(--f-line-contrast); outline-offset:-2px; }

/* ---------- Row actions ------------------------------------------------- */
.f-rowacts{ display:flex; align-items:center; gap:2px; opacity:0;
  transition: opacity var(--f-t-hover) var(--f-e-io); }
tr:hover .f-rowacts{ opacity:1; }

/* ---------- Empty state ------------------------------------------------- */
.f-empty{ display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:48px 24px; text-align:center; gap:8px; }
.f-empty__art{ display:flex; gap:6px; margin-bottom:8px; }
.f-empty__art>i{ width:8px; height:8px; border-radius:50%; background:var(--f-line-strong); }
.f-empty__art>i:nth-child(1){ opacity:.3; } .f-empty__art>i:nth-child(2){ opacity:.5; }
.f-empty__art>i:nth-child(3){ opacity:.7; } .f-empty__art>i:nth-child(4){ opacity:.9; }
.f-empty h4{ font:700 var(--f-t-lg)/1.3 var(--f-font); color:var(--f-text); margin:0; }
.f-empty p{ font-size:var(--f-t-sm); color:var(--f-text-3); margin:0; max-width:360px; }

/* ---------- Tooltip ----------------------------------------------------- */
.f-tip{
  z-index:80; padding:5px 9px; border-radius:var(--f-r-2);
  background:var(--f-ink-900); color:var(--f-text-inv);
  font:500 var(--f-t-xs)/1.3 var(--f-font); white-space:nowrap;
  box-shadow:var(--f-d-2); animation: fade-in 0.15s ease-out; }
.dark .f-tip{ background:var(--f-ink-000); color:var(--f-text); }

/* ---------- Segmented control ------------------------------------------- */
.f-seg{ display:inline-flex; padding:2px; border-radius:var(--f-r-3);
  background:var(--f-surface-sunken); border:1px solid var(--f-line); }
.f-seg button{
  position:relative; display:flex; align-items:center; justify-content:center;
  height:26px; padding:0 12px; border:none; background:transparent; cursor:pointer;
  font:600 var(--f-t-sm)/1 var(--f-font); color:var(--f-text-3); border-radius:var(--f-r-2);
  transition: color var(--f-t-hover) var(--f-e-io); }
.f-seg button[aria-selected="true"]{ color:var(--f-text); }
.f-seg__pill{ position:absolute; inset:0; z-index:-1; border-radius:var(--f-r-2);
  background:var(--f-surface); box-shadow:var(--f-d-1); }

/* ---------- Field -------------------------------------------------------- */
.f-field{ display:flex; flex-direction:column; gap:5px; }
.f-field>label{ font:600 var(--f-t-sm)/1.3 var(--f-font); color:var(--f-text-2); }
.f-field__hint{ font-size:var(--f-t-xs); color:var(--f-text-3); }
.f-field__err{ font-size:var(--f-t-xs); color:var(--f-bad); }
.f-input{
  height:var(--f-row); padding:0 10px; border-radius:var(--f-r-2);
  border:1px solid var(--f-line-strong); background:var(--f-surface);
  font:500 var(--f-t-md)/1 var(--f-font); color:var(--f-text); outline:none;
  transition: border-color var(--f-t-hover) var(--f-e-io),
              box-shadow var(--f-t-hover) var(--f-e-io); }
.f-input:focus{ border-color:var(--f-line-contrast); box-shadow:0 0 0 3px color-mix(in oklab, var(--f-line-contrast) 12%, transparent); }
.f-input[aria-invalid="true"]{ border-color:var(--f-bad); }
textarea.f-input{ height:auto; padding:8px 10px; resize:vertical; line-height:1.45; }

/* ---------- Scrim -------------------------------------------------------- */
.f-scrim{ position:fixed; inset:0; z-index:45; background: rgb(0 0 0 / .35);
  backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }

/* ---------- Responsive --------------------------------------------------- */
@media (max-width:768px){
  .f-shell{ grid-template-columns: minmax(0,1fr); }
  .f-shell .f-rail{ display:none; }
  .f-cmd-trigger{ min-width:0; flex:1; max-width:200px; }
}

/* ---------- Icon wrapper (for cards, widgets) ---------------------------- */
.f-icon-wrap{
  display:flex; align-items:center; justify-content:center;
  width:32px; height:32px; border-radius:var(--f-r-2); flex-shrink:0;
  background:var(--f-surface-sunken); border:1px solid var(--f-line);
  color:var(--f-text-2);
}
.f-icon-wrap--ok{ background:var(--f-ok-bg); border-color:color-mix(in oklab,var(--f-ok) 25%,transparent); color:var(--f-ok); }
.f-icon-wrap--warn{ background:var(--f-warn-bg); border-color:color-mix(in oklab,var(--f-warn) 25%,transparent); color:var(--f-warn); }
.f-icon-wrap--bad{ background:var(--f-bad-bg); border-color:color-mix(in oklab,var(--f-bad) 25%,transparent); color:var(--f-bad); }
.f-icon-wrap--info{ background:var(--f-info-bg); border-color:color-mix(in oklab,var(--f-info) 25%,transparent); color:var(--f-info); }

/* ---------- Restaurant Kitchen (KDS) animations ------------------------- */
@keyframes kds-pulse-red {
  0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--f-bad) 70%, transparent); }
  70% { box-shadow: 0 0 0 10px color-mix(in oklab, var(--f-bad) 0%, transparent); }
  100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--f-bad) 0%, transparent); }
}
@keyframes kds-pulse-amber {
  0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--f-warn) 70%, transparent); }
  70% { box-shadow: 0 0 0 10px color-mix(in oklab, var(--f-warn) 0%, transparent); }
  100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--f-warn) 0%, transparent); }
}
@keyframes glow-rush {
  0%, 100% { border-color: var(--f-bad); filter: drop-shadow(0 0 2px var(--f-bad)); }
  50% { border-color: var(--f-tint-color); filter: drop-shadow(0 0 8px var(--f-tint-color)); }
}
.kds-card-rush { animation: glow-rush 2s infinite ease-in-out; border-width: 2px !important; }
.pulse-amber { animation: kds-pulse-amber 2s infinite; }
.pulse-red { animation: kds-pulse-red 1.5s infinite; }
.kds-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
.kds-kiosk { font-size: 1.15rem; }
.kds-kiosk button, .kds-kiosk select, .kds-kiosk input { min-height: 48px; }
.f-ticket--overdue { animation: kds-pulse-red 1.5s infinite; }
